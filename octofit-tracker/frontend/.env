# API Configuration
# Priority:
# 1. REACT_APP_API_BASE_URL - Use this for explicit API URL (recommended)
# 2. REACT_APP_CODESPACE_NAME - Used for GitHub Codespaces (auto-populated)
# 3. If neither is set, defaults to http://localhost:8000

# For local development (recommended):
REACT_APP_API_BASE_URL=http://localhost:8000

# For GitHub Codespaces (uncomment and set when in Codespaces):
# REACT_APP_CODESPACE_NAME=bug-free-goldfish-pqgxwp57wvc6q9q
