# API Configuration
# Option 1: Provide the full API base URL directly (recommended for local dev)
# REACT_APP_API_BASE_URL=http://localhost:8000

# Option 2: For GitHub Codespaces, set the codespace name
# The app will automatically construct: https://{CODESPACE_NAME}-8000.app.github.dev
# Example: REACT_APP_CODESPACE_NAME=your-codespace-name
REACT_APP_CODESPACE_NAME=

# If neither is set, the app defaults to http://localhost:8000
