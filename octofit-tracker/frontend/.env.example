# API Configuration
# Priority:
# 1. REACT_APP_API_BASE_URL - Use this for explicit API URL (recommended)
# 2. REACT_APP_CODESPACE_NAME - Used for GitHub Codespaces (auto-populated)
# 3. If neither is set, defaults to http://localhost:8000

# For local development:
REACT_APP_API_BASE_URL=http://localhost:8000

# For GitHub Codespaces (optional - usually auto-detected):
# You can get this from the CODESPACE_NAME environment variable in your terminal
# Example: REACT_APP_CODESPACE_NAME=your-codespace-name
REACT_APP_CODESPACE_NAME=
